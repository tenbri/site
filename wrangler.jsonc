{
	"name": "tenbri-site",
	"compatibility_date": "2026-10-01",
	"main": "worker/index.js",
	"routes": [
		{ "pattern": "tenbri.com", "custom_domain": true },
		{ "pattern": "www.tenbri.com", "custom_domain": true }
	],
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": true,
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	}
}
