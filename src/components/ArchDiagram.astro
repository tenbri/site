---
// Tenbri's architecture as a top-to-bottom pipeline: write, sign and chain, store, prove.
// Each part is marked core (solid), optional (dashed) or coming soon (dotted, muted).
type Kind = 'core' | 'optional' | 'soon' | 'progress';
interface Part { name: string; detail?: string; kind: Kind; href?: string }
interface Tier { step: string; title: string; caption: string; parts: Part[] }

const tiers: Tier[] = [
	{
		step: '1',
		title: 'Write',
		caption: 'Where decisions come from',
		parts: [
			{ name: '@tenbri.decision', detail: 'Python and TypeScript functions', kind: 'core', href: '/docs/reference/sdk/' },
			{ name: 'Framework adapters', detail: 'Claude Agent SDK, OpenAI Agents SDK, LangGraph', kind: 'core', href: '/docs/adapters/' },
			{ name: 'tenbri CLI', detail: 'tenbri append, one JSON entry', kind: 'core', href: '/docs/reference/cli/' },
			{ name: 'tenbrid', detail: 'REST and gRPC daemon, for any language', kind: 'optional', href: '/docs/reference/api/' },
			{ name: 'Proxy-observed entries', detail: 'what an agent did on the network', kind: 'soon' },
			{ name: 'Ingest and Kafka', detail: 'entries from existing pipelines', kind: 'soon' },
		],
	},
	{
		step: '2',
		title: 'Sign and chain',
		caption: 'The Rust core, in every SDK and in tenbrid',
		parts: [
			{ name: 'Intent, then outcome', detail: 'written before the action, closed after it', kind: 'core', href: '/docs/concepts/streams-and-entries/' },
			{ name: 'Hash chain and Ed25519', detail: 'canonical bytes, prev hash, session key signature', kind: 'core', href: '/docs/concepts/integrity/' },
			{ name: 'Keys', detail: 'stream key, 24 h session keys, key files', kind: 'core', href: '/docs/concepts/keys/' },
			{ name: 'OS keychain', detail: 'macOS and Windows', kind: 'optional', href: '/docs/concepts/keys/' },
			{ name: 'Action schemas', detail: 'tenbri.toml: targets, policies, approvals', kind: 'optional', href: '/docs/reference/schemas/' },
			{ name: 'Privacy', detail: 'encrypted bodies, keyed digests, erasure', kind: 'optional', href: '/docs/concepts/privacy/' },
			{ name: 'PKCS#11, cloud KMS, passkeys', kind: 'soon' },
		],
	},
	{
		step: '3',
		title: 'Store',
		caption: 'Plain files on storage you control, keys kept apart',
		parts: [
			{ name: 'Local disk', kind: 'core', href: '/docs/reference/storage/' },
			{ name: 'Cloudflare R2 and MinIO', kind: 'core', href: '/docs/examples/object-storage/' },
			{ name: 'AWS S3', detail: 'tested on MinIO, real S3 before rc.1', kind: 'progress', href: '/docs/examples/object-storage/' },
			{ name: 'Query index', detail: 'SQLite or Parquet, re-checked against storage', kind: 'optional', href: '/docs/reference/storage/' },
			{ name: 'GCS, Azure Blob, Postgres', kind: 'soon' },
			{ name: 'Iceberg index, --as-of', kind: 'soon' },
		],
	},
	{
		step: '4',
		title: 'Prove',
		caption: 'Anyone checks it offline, with one pinned fingerprint',
		parts: [
			{ name: 'Verify', detail: 'CLI, Python, Node, tenbrid', kind: 'core', href: '/docs/examples/verify-as-an-auditor/' },
			{ name: 'Query and tail', detail: 'by input version, rule, action, trace', kind: 'core', href: '/docs/examples/policy-change-review/' },
			{ name: 'Checkpoints and receipts', detail: 'Merkle proofs an auditor verifies alone', kind: 'core', href: '/docs/concepts/integrity/' },
			{ name: 'WASM verifier', detail: 'verify in the browser', kind: 'optional', href: '/docs/getting-started/install/' },
			{ name: 'RFC 3161 timestamps', kind: 'optional', href: '/docs/concepts/integrity/' },
			{ name: 'Witnesses, Rekor, checkpoint publishing', kind: 'soon' },
			{ name: 'Silent-stream and undeclared-action alerts', kind: 'soon' },
			{ name: 'Read-only viewer, MCP server, exports', kind: 'soon' },
		],
	},
];
const label: Record<Kind, string> = { core: '', optional: 'optional', soon: 'coming soon', progress: 'in progress' };
---

<figure class="arch not-content" aria-label="Tenbri architecture">
	<ul class="legend" aria-label="Legend">
		<li><span class="sw core"></span>Core</li>
		<li><span class="sw optional"></span>Optional</li>
		<li><span class="sw progress"></span>In progress</li>
		<li><span class="sw soon"></span>Coming soon</li>
	</ul>
	{tiers.map((t, i) => (
		<>
			<section class="tier">
				<header>
					<span class="step">{t.step}</span>
					<div>
						<p class="tt">{t.title}</p>
						<p class="tc">{t.caption}</p>
					</div>
				</header>
				<ul class="parts">
					{t.parts.map((p) => {
						const Tag = p.href ? 'a' : 'div';
						return (
							<li>
								<Tag class:list={['part', p.kind]} href={p.href}>
									<span class="pn">{p.name}</span>
									{p.detail && <span class="pd">{p.detail}</span>}
									{label[p.kind] && <span class="badge">{label[p.kind]}</span>}
								</Tag>
							</li>
						);
					})}
				</ul>
			</section>
			{i < tiers.length - 1 && (
				<div class="flow" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m-6-6 6 6 6-6" /></svg>
				</div>
			)}
		</>
	))}
</figure>

<style>
	.arch {
		margin: 2rem 0;
		padding: clamp(1rem, 3vw, 1.5rem);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		display: grid;
		gap: 0.25rem;
	}
	.legend { list-style: none; margin: 0 0 0.9rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; font-size: 0.8rem; color: var(--sl-color-gray-3); }
	.legend li { display: inline-flex; align-items: center; gap: 0.45rem; margin: 0; }
	.sw { width: 1.4rem; height: 0.9rem; border-radius: 0.3rem; border: 1.5px solid var(--sl-color-gray-3); background: var(--sl-color-black); }
	.sw.core { border-color: var(--stamp); }
	.sw.optional { border-style: dashed; }
	.sw.progress { border-color: var(--amber); border-style: dashed; }
	.sw.soon { border-style: dotted; opacity: 0.6; }

	.tier {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.85rem;
		background: var(--sl-color-black);
		padding: 1rem;
		display: grid;
		gap: 0.85rem;
	}
	.tier header { display: flex; align-items: center; gap: 0.75rem; }
	.step {
		flex: none;
		display: grid; place-items: center;
		width: 1.9rem; height: 1.9rem;
		border-radius: 50%;
		background: var(--stamp);
		color: #fff;
		font: 600 0.85rem/1 var(--font-mono);
	}
	.tt { margin: 0; font: 750 1.05rem/1.2 var(--font-display); color: var(--sl-color-white); }
	.tc { margin: 0; font-size: 0.85rem; color: var(--sl-color-gray-3); }
	.parts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr)); gap: 0.5rem; }
	.parts li { margin: 0; display: flex; }
	.part {
		flex: 1;
		display: grid; align-content: start; gap: 0.2rem;
		padding: 0.6rem 0.75rem;
		border-radius: 0.6rem;
		border: 1.5px solid var(--sl-color-gray-4);
		color: var(--sl-color-white);
		text-decoration: none;
		position: relative;
	}
	a.part:hover { background: var(--sl-color-gray-6); }
	.part.core { border-color: var(--stamp); }
	.part.optional { border-style: dashed; }
	.part.progress { border-color: var(--amber); border-style: dashed; }
	.part.soon { border-style: dotted; color: var(--sl-color-gray-3); }
	.pn { font-weight: 600; font-size: 0.9rem; line-height: 1.3; }
	.pd { font-size: 0.78rem; line-height: 1.35; color: var(--sl-color-gray-3); }
	.badge {
		justify-self: start;
		margin-top: 0.25rem;
		font: 500 0.66rem/1 var(--font-mono);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.25rem 0.4rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
	}
	.progress .badge { color: var(--amber); }
	.flow { display: grid; place-items: center; color: var(--stamp); padding: 0.15rem 0; }
</style>
