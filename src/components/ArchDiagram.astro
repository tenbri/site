---
// Tenbri's architecture as a stage-by-status matrix: four step headings across the top,
// one row per status (available, optional, coming soon). A part's row is its status.
interface Item { name: string; detail?: string; href?: string }
interface Stage { title: string; who: string; available: Item[]; optional: Item[]; soon: string[] }
interface Props { wide?: boolean }
const { wide = false } = Astro.props;

const stages: Stage[] = [
	{
		title: 'Write',
		who: 'Your agents and services',
		available: [
			{ name: '@tenbri.decision', detail: 'Python, TypeScript', href: '/docs/reference/sdk/' },
			{ name: 'Framework adapters', detail: 'Claude, OpenAI, LangGraph', href: '/docs/adapters/' },
			{ name: 'tenbri CLI', detail: 'tenbri append', href: '/docs/reference/cli/' },
		],
		optional: [{ name: 'tenbrid', detail: 'REST and gRPC daemon', href: '/docs/reference/api/' }],
		soon: ['Proxy-observed entries', 'Ingest and Kafka'],
	},
	{
		title: 'Sign and chain',
		who: 'Tenbri core, in Rust',
		available: [
			{ name: 'Intent, then outcome', detail: 'durable before the action', href: '/docs/concepts/streams-and-entries/' },
			{ name: 'Hash chain, Ed25519', detail: 'certified session keys', href: '/docs/concepts/integrity/' },
		],
		optional: [
			{ name: 'Action schemas', detail: 'tenbri.toml', href: '/docs/reference/schemas/' },
			{ name: 'Privacy', detail: 'encrypted bodies, erasure', href: '/docs/concepts/privacy/' },
			{ name: 'OS keychain', detail: 'macOS, Windows', href: '/docs/concepts/keys/' },
		],
		soon: ['PKCS#11, cloud KMS', 'Passkey attestations'],
	},
	{
		title: 'Store',
		who: 'Storage you control',
		available: [
			{ name: 'Local disk', href: '/docs/reference/storage/' },
			{ name: 'Cloudflare R2, MinIO', href: '/docs/examples/object-storage/' },
			{ name: 'AWS S3', detail: 'in progress, real S3 before rc.1', href: '/docs/examples/object-storage/' },
		],
		optional: [{ name: 'Query index', detail: 'SQLite or Parquet', href: '/docs/reference/storage/' }],
		soon: ['GCS, Azure Blob, Postgres', 'Iceberg index, --as-of'],
	},
	{
		title: 'Prove',
		who: 'Anyone with the fingerprint',
		available: [
			{ name: 'Verify offline', detail: 'CLI, Python, Node', href: '/docs/examples/verify-as-an-auditor/' },
			{ name: 'Query and tail', detail: 'by policy version', href: '/docs/examples/policy-change-review/' },
			{ name: 'Checkpoints, receipts', detail: 'proof of one decision', href: '/docs/concepts/integrity/' },
		],
		optional: [
			{ name: 'WASM verifier', detail: 'in the browser', href: '/docs/getting-started/install/' },
			{ name: 'RFC 3161 timestamps', href: '/docs/concepts/integrity/' },
		],
		soon: ['Witnesses, Rekor', 'Silent-stream alerts', 'Viewer, MCP, exports'],
	},
];
const rows = [
	{ key: 'available', label: 'Available' },
	{ key: 'optional', label: 'Optional' },
	{ key: 'soon', label: 'Coming soon' },
] as const;
---

<figure class:list={['arch not-content', { wide }]} aria-label="Tenbri architecture by stage and status">
	<!-- Matrix: wide screens -->
	<div class="matrix" role="table" aria-label="Parts of Tenbri by stage and status">
		<div class="corner" role="rowheader"></div>
		{stages.map((s, i) => (
			<div class:list={['hd', { last: i === stages.length - 1 }]} role="columnheader">
				<span class="t">{s.title}</span>
				<span class="w">{s.who}</span>
			</div>
		))}
		{rows.map((r) => (
			<>
				<div class:list={['rl', r.key]} role="rowheader"><span class:list={['mk', r.key]} aria-hidden="true"></span>{r.label}</div>
				{stages.map((s) => (
					<div class:list={['cell', r.key]} role="cell">
						{r.key === 'soon'
							? s.soon.map((n) => <span class="it"><span class="nm">{n}</span></span>)
							: (s[r.key] as Item[]).map((it) => (
								<a class="it" href={it.href}>
									<span class="nm">{it.name}</span>
									{it.detail && <span class="dt">{it.detail}</span>}
								</a>
							))}
					</div>
				))}
			</>
		))}
	</div>

	<!-- Stacked: narrow screens -->
	<ol class="stack">
		{stages.map((s, i) => (
			<li>
				<p class="sh">{s.title}<span class="w">{s.who}</span></p>
				{rows.map((r) => {
					const list = r.key === 'soon' ? s.soon.map((n) => ({ name: n }) as Item) : (s[r.key] as Item[]);
					return list.length > 0 && (
						<div class:list={['sr', r.key]}>
							<p class="rl"><span class:list={['mk', r.key]} aria-hidden="true"></span>{r.label}</p>
							<ul>{list.map((it) => <li>{it.href ? <a href={it.href}>{it.name}</a> : it.name}{it.detail && <span class="dt"> · {it.detail}</span>}</li>)}</ul>
						</div>
					);
				})}
			</li>
		))}
	</ol>

	<figcaption>
		<p class="take"><strong>One Rust core</strong> behind every SDK, the CLI and tenbrid. Entries are signed and chained before they reach storage; signing keys never live with the stream.</p>
		<p class="src">Status as of 0.1.0-beta.2. Source: the <a href="https://github.com/tenbri/tenbri#status">Tenbri roadmap</a>.</p>
	</figcaption>
</figure>

<style>
	.arch {
		--a-line: var(--sl-color-gray-5, var(--rule));
		--a-muted: var(--sl-color-gray-3, var(--ink-2));
		--a-ink: var(--sl-color-white, var(--ink));
		--a-bg: var(--sl-color-black, var(--paper));
		--a-tint: var(--sl-color-gray-6, var(--paper-2));
		margin: 2rem 0;
		display: grid;
		gap: 1.1rem;
		font-family: var(--font-body);
		container-type: inline-size;
	}

	/* Matrix */
	.matrix {
		display: grid;
		grid-template-columns: 7.5rem repeat(4, minmax(0, 1fr));
		border-bottom: 1px solid var(--a-line);
	}
	.corner { border-bottom: 1px solid var(--a-line); }
	.hd {
		position: relative;
		display: grid; gap: 0.2rem; align-content: end;
		padding: 0.9rem 0.9rem 0.85rem;
		border-top: 3px solid var(--stamp);
		border-bottom: 1px solid var(--a-line);
	}
	.hd + .hd { border-left: 1px solid var(--a-line); }
	.hd:not(.last)::after {
		content: '›';
		position: absolute; z-index: 1;
		right: -0.7rem; top: 50%;
		translate: 0 -50%;
		display: grid; place-items: center;
		width: 1.4rem; height: 1.4rem;
		border: 1px solid var(--a-line);
		border-radius: 50%;
		background: var(--a-bg);
		color: var(--stamp);
		font: 700 0.95rem/1 var(--font-body);
	}
	.hd .t { font: 750 1.02rem/1.2 var(--font-display); letter-spacing: -0.01em; color: var(--a-ink); }
	.hd .w { font-size: 0.78rem; line-height: 1.3; color: var(--a-muted); }

	.rl {
		display: flex; align-items: flex-start; gap: 0.5rem;
		padding: 0.95rem 0.75rem 0.95rem 0;
		font: 600 0.7rem/1.3 var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--a-ink);
		border-top: 1px solid var(--a-line);
	}
	.cell {
		display: grid; align-content: start; gap: 0.65rem;
		padding: 0.95rem 0.9rem;
		border-top: 1px solid var(--a-line);
		border-left: 1px solid var(--a-line);
	}
	.cell.optional { background: color-mix(in srgb, var(--a-tint) 55%, transparent); }
	.rl.optional { background: color-mix(in srgb, var(--a-tint) 55%, transparent); padding-left: 0.5rem; margin-left: -0.5rem; }
	.cell.soon .nm, .rl.soon { color: var(--a-muted); }
	.cell.soon .nm { font-weight: 500; }

	.mk { flex: none; width: 0.6rem; height: 0.6rem; margin-top: 0.12rem; }
	.mk.available { background: var(--a-ink); }
	.mk.optional { border: 1.5px solid var(--a-ink); }
	.mk.soon { border: 1.5px dashed var(--a-muted); border-radius: 50%; }

	.it { display: grid; gap: 0.05rem; text-decoration: none; color: var(--a-ink); }
	a.it:hover .nm { text-decoration: underline; text-decoration-color: var(--stamp); text-underline-offset: 3px; }
	.nm { font-weight: 600; font-size: 0.86rem; line-height: 1.3; }
	.dt { font-size: 0.75rem; line-height: 1.3; color: var(--a-muted); }

	figcaption { display: grid; gap: 0.4rem; }
	.take { margin: 0; padding-left: 0.8rem; border-left: 3px solid var(--stamp); font-size: 0.92rem; color: var(--a-ink); }
	.take strong { font-weight: 700; }
	.src { margin: 0; font-size: 0.72rem; color: var(--a-muted); }
	.src a { color: inherit; }

	/* Stacked list for narrow screens */
	.stack { display: none; list-style: none; margin: 0; padding: 0; gap: 0.75rem; }
	.stack > li { margin: 0; border: 1px solid var(--a-line); border-radius: 0.6rem; overflow: hidden; }
	.sh { margin: 0; display: grid; gap: 0.15rem; padding: 0.75rem 0.9rem; border-top: 3px solid var(--stamp); color: var(--a-ink); font: 750 1rem/1.2 var(--font-display); }
	.sh .w { font: 400 0.78rem/1.3 var(--font-body); color: var(--a-muted); }
	.sr { padding: 0.6rem 0.9rem 0.7rem; border-top: 1px solid var(--a-line); }
	.sr.optional { background: color-mix(in srgb, var(--a-tint) 55%, transparent); }
	.sr .rl { border: 0; padding: 0 0 0.35rem; }
	.sr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; font-size: 0.86rem; }
	.sr li { margin: 0; }
	.sr a { color: var(--a-ink); font-weight: 600; text-decoration: none; }
	.sr.soon li { color: var(--a-muted); }

	@container (max-width: 820px) {
		.matrix { display: none; }
		.stack { display: grid; }
	}
	.arch.wide { margin: 0; }
</style>
