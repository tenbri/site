---
// Shared shell for the landing page and the blog: head, announcement, nav, footer, base styles.
import { Image } from 'astro:assets';
import mascot from '../assets/mascot.webp';
import '../styles/tokens.css';

interface Props {
	title: string;
	description: string;
	/** Always dark, whatever the visitor's theme (the landing page). */
	dark?: boolean;
	announce?: { text: string; href: string };
}
const { title, description, dark = false, announce } = Astro.props;
const path = Astro.url.pathname;

const columns = [
	{
		title: 'Learn',
		links: [
			['Quickstart', '/docs/getting-started/quickstart/'],
			['Install', '/docs/getting-started/install/'],
			['Concepts', '/docs/concepts/streams-and-entries/'],
			['Examples', '/docs/examples/'],
		],
	},
	{
		title: 'Integrate',
		links: [
			['Claude Agent SDK', '/docs/adapters/claude-agent-sdk/'],
			['OpenAI Agents SDK', '/docs/adapters/openai-agents/'],
			['LangGraph and LangChain', '/docs/adapters/langgraph/'],
			['REST and gRPC', '/docs/reference/api/'],
		],
	},
	{
		title: 'Project',
		links: [
			['GitHub', 'https://github.com/tenbri/tenbri'],
			['Releases', 'https://github.com/tenbri/tenbri/releases'],
			['Format spec', 'https://github.com/tenbri/tenbri/tree/main/spec'],
			['Security', 'https://github.com/tenbri/tenbri/blob/main/SECURITY.md'],
		],
	},
	{
		title: 'News',
		links: [
			['Blog', '/blog/'],
			['RSS', '/blog/rss.xml'],
		],
	},
];
---

<!doctype html>
<html lang="en" data-theme={dark ? 'dark' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" href="/favicon.png" />
		<link rel="alternate" type="application/rss+xml" title="Tenbri blog" href="/blog/rss.xml" />
		{!dark && (
			<script is:inline>
				// Share the theme the docs remember (Starlight stores it under this key).
				try {
					const t = localStorage.getItem('starlight-theme');
					if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
				} catch {}
			</script>
		)}
	</head>
	<body>
		{announce && (
			<a class="announce" href={announce.href}>
				<span>{announce.text}</span>
				<span aria-hidden="true">→</span>
			</a>
		)}
		<header class="nav">
			<div class="wrap nav-row">
				<a class="brand" href="/">
					<Image src={mascot} alt="" width={28} height={28} densities={[1, 2, 3]} />
					<span>Tenbri</span>
				</a>
				<nav aria-label="Main">
					<a href="/docs/introduction/">Docs</a>
					<a class="wide" href="/docs/examples/">Examples</a>
					<a class="wide" href="/docs/adapters/">Adapters</a>
					<a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
					<a class="gh" href="https://github.com/tenbri/tenbri" aria-label="Tenbri on GitHub">
						<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
						<span class="wide">GitHub</span>
					</a>
				</nav>
			</div>
		</header>

		<slot />

		<footer class="foot">
			<div class="wrap foot-grid">
				<div class="foot-brand">
					<a class="brand" href="/">
						<Image src={mascot} alt="" width={28} height={28} densities={[1, 2, 3]} />
						<span>Tenbri</span>
					</a>
					<p>Audit trail for AI agents. Every decision signed, chained and provable.</p>
					<p class="fine">Apache-2.0 · Written in Rust · No telemetry</p>
				</div>
				{columns.map((c) => (
					<nav aria-label={c.title}>
						<p class="col-title">{c.title}</p>
						<ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
					</nav>
				))}
			</div>
		</footer>
	</body>
</html>

<style>
	:global(*, *::before, *::after) { box-sizing: border-box; }
	:global(html) { -webkit-text-size-adjust: 100%; }
	:global(body) {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font: 400 1.0625rem/1.6 var(--font-body);
	}
	:global(main) { overflow-x: clip; }
	:global(a) { color: inherit; }
	:global(:focus-visible) { outline: 2px solid var(--stamp); outline-offset: 3px; border-radius: 4px; }
	:global(.wrap) {
		max-width: 72rem;
		margin-inline: auto;
		padding-left: max(20px, env(safe-area-inset-left, 0px));
		padding-right: max(20px, env(safe-area-inset-right, 0px));
	}

	.announce {
		display: flex; justify-content: center; gap: 0.5rem;
		padding: 0.55rem max(20px, env(safe-area-inset-right, 0px)) 0.55rem max(20px, env(safe-area-inset-left, 0px));
		background: var(--stamp);
		color: #fff;
		font: 600 0.88rem/1.3 var(--font-body);
		text-align: center;
		text-decoration: none;
	}
	.announce:hover span:first-child { text-decoration: underline; text-underline-offset: 3px; }

	.nav {
		position: sticky;
		top: env(safe-area-inset-top, 0px);
		z-index: 10;
		background: color-mix(in srgb, var(--paper) 80%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--rule);
	}
	.nav-row { display: flex; align-items: center; justify-content: space-between; height: 3.75rem; }
	.brand { display: flex; align-items: center; gap: 0.5rem; flex: none; text-decoration: none; font: 800 1.25rem/1 var(--font-display); letter-spacing: -0.03em; }
	.brand :global(img) { width: 28px; height: 28px; }
	.nav nav { display: flex; align-items: center; gap: 1.6rem; font-weight: 500; font-size: 0.95rem; }
	.nav nav a { text-decoration: none; color: var(--ink-2); }
	.nav nav a:hover, .nav nav a[aria-current='page'] { color: var(--ink); }
	.gh { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.75rem; border: 1px solid var(--rule); border-radius: 0.55rem; }

	.foot { border-top: 1px solid var(--rule); color: var(--ink-2); font-size: 0.92rem; }
	.foot-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
		gap: 2rem;
		padding-block: 3.5rem calc(3rem + env(safe-area-inset-bottom, 0px));
	}
	.foot-brand { display: grid; gap: 0.8rem; align-content: start; max-width: 20rem; }
	.foot-brand .brand { color: var(--ink); }
	.foot p { margin: 0; }
	.fine { font: 500 0.75rem/1.4 var(--font-mono); }
	.col-title { font: 500 0.72rem/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); margin-bottom: 0.9rem !important; }
	.foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
	.foot a { text-decoration: none; }
	.foot a:hover { color: var(--ink); }

	@media (max-width: 860px) {
		.foot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.foot-brand { grid-column: 1 / -1; }
	}
	@media (max-width: 760px) {
		.nav .wide { display: none; }
		.nav nav { gap: 1.1rem; }
	}
</style>
