---
import { Image } from 'astro:assets';
import mascot from '../assets/mascot.webp';
import Site from '../layouts/Site.astro';
import CodeWindow from '../components/CodeWindow.astro';
import TerminalPlayer from '../components/TerminalPlayer.astro';
import claudeIcon from '@lobehub/icons-static-svg/icons/claude-color.svg?raw';
import openaiIcon from '@lobehub/icons-static-svg/icons/openai.svg?raw';
import langgraphIcon from '@lobehub/icons-static-svg/icons/langgraph.svg?raw';
import langchainIcon from '@lobehub/icons-static-svg/icons/langchain-color.svg?raw';
import hfIcon from '@lobehub/icons-static-svg/icons/huggingface-color.svg?raw';
import { siPython, siTypescript } from 'simple-icons';

const title = 'Tenbri: audit trail for AI agents';
const description =
	'Open-source, tamper-evident record of what AI agents decided: hash-chained, signed and verifiable offline, on storage you control.';

const installs = [
	{ id: 'pip', cmd: 'pip install --pre tenbri' },
	{ id: 'uv', cmd: 'uv add --prerelease=allow tenbri' },
	{ id: 'npm', cmd: 'npm install tenbri@next' },
	{ id: 'cargo', cmd: 'cargo install tenbri-cli --version 0.1.0-beta.2 --locked' },
];

// Section 1: instrument an agent in three lines.
const quick = [
	{
		name: 'agent.py',
		lang: 'python',
		code: `import tenbri

tenbri.init()                        # TENBRI_STREAM, TENBRI_AGENT, TENBRI_APPROVER
tenbri.instrument_claude_agent_sdk() # every tool call becomes a signed decision

# or: tenbri.instrument_openai_agents()
# or: tenbri.instrument_langchain()`,
	},
	{
		name: 'agent.ts',
		lang: 'typescript',
		code: `import { init } from 'tenbri'
import { instrumentLangChain } from '@tenbri/langgraph'

init()                // TENBRI_STREAM, TENBRI_AGENT, TENBRI_APPROVER
instrumentLangChain() // every tool call becomes a signed decision

// or: instrumentClaudeAgentSdk(options) from '@tenbri/claude-agent-sdk'
// or: instrumentOpenAIAgents() from '@tenbri/openai-agents'`,
	},
	{
		name: 'refund.py',
		lang: 'python',
		code: `import tenbri

tenbri.init()

@tenbri.decision("issue_refund", target="stripe:{charge}", policy="policy:refund@14")
def refund(charge: str, amount: int) -> None:
    if amount > 500:
        raise tenbri.Refused("over the ceiling")  # recorded as refused
    stripe.Refund.create(charge=charge, amount=amount)

refund("ch_81f2", 4200)  # intent before it runs, outcome after`,
	},
	{
		name: 'refund.ts',
		lang: 'typescript',
		code: `import { Refused, decision, init } from 'tenbri'

init()

const refund = decision(
  { action: 'issue_refund', target: 'stripe:{charge}', policy: 'policy:refund@14' },
  async ({ charge, amount }: { charge: string; amount: number }) => {
    if (amount > 500) throw new Refused('over the ceiling') // recorded as refused
    await stripe.refunds.create({ charge, amount })
  },
)

await refund({ charge: 'ch_81f2', amount: 4200 }) // intent before, outcome after`,
	},
];

// Section 3: features, each with real commands and output.
const features = [
	{
		badge: 'Verify',
		title: 'Anyone can check it, offline',
		body: 'Hand an auditor the stream and one fingerprint. Verification checks canonical bytes, the hash chain, every Ed25519 signature and every key, with no access to your systems. A checkpoint they kept catches truncation and forks.',
		link: ['How integrity works', '/docs/concepts/integrity/'],
		file: { name: 'terminal', lang: 'shellsession', code: `$ tenbri verify ./audit/support --key sha256:9c1e…
verified 1204 entries, stream tnb1:1702…b7d8, pinned to sha256:9c1e…

$ tenbri verify ./audit/support --key sha256:9c1e…   # after a one-byte edit
broken at seq 3: bad_signature
2 entries verified before it, stream tnb1:1702…b7d8` },
	},
	{
		badge: 'Query',
		title: 'Every decision made under the old rule',
		body: 'Inputs are pinned by reference, version and keyed digest. When a policy changes, list what was decided under the previous version and review it. Each answer is re-checked against storage before it is returned.',
		link: ['Review a policy change', '/docs/examples/policy-change-review/'],
		file: { name: 'terminal', lang: 'shellsession', code: `$ tenbri query ./audit/support --input policy:refund@14 \\
    | jq -c '{seq, action: .entry.action.type, target: .entry.action.target}'
{"seq":2,"action":"issue_refund","target":"stripe:ch_81f2"}
{"seq":5,"action":"issue_refund","target":"stripe:ch_93aa"}

$ tenbri tail ./audit/support -n 20   # follow decisions as agents write them` },
	},
	{
		badge: 'Schemas',
		title: 'Say what each action must record',
		body: 'Declare actions once in tenbri.toml. The SDKs read it to map tool calls to actions, targets and policies, tenbrid enforces it at write time, and CI checks whole streams against it.',
		link: ['Action schemas', '/docs/reference/schemas/'],
		file: { name: 'tenbri.toml', lang: 'toml', code: `unknown_actions = "reject"

[actions.issue_refund]
target   = "stripe:{charge}"     # filled from the tool call's arguments
policy   = "policy:refund@14"    # the rule that allowed it
approval = true                  # a person must approve first
inputs   = ["policy:refund"]

[actions.issue_refund.fields."ext.refund.amount"]
required = true
type = "integer"` },
	},
	{
		badge: 'Receipts',
		title: 'Proof you can hand over',
		body: 'A receipt proves specific entries with their inclusion proofs, the key history and an optional RFC 3161 timestamp. A customer, a regulator or the police verify it alone, without seeing the rest of the stream.',
		link: ['Receipts and timestamps', '/docs/concepts/integrity/'],
		file: { name: 'terminal', lang: 'shellsession', code: `$ tenbri receipt create ./audit/support --entry 3 --out refund-3.receipt
$ tenbri receipt verify refund-3.receipt --key sha256:9c1e…
proves seq 3 (decision intent), id 01M4XBH0Y6…, ts 2026-10-14T14:02:13Z (claimed by the writer)
in stream tnb1:1702…b7d8, checkpoint at size 8, pinned to sha256:9c1e…; key history: 2 key entries` },
	},
	{
		badge: 'Privacy',
		title: 'Erase a person without breaking the chain',
		body: 'Only hashes go in the chain. Bodies are encrypted and input digests are keyed per subject, so deleting a subject\'s keys makes their data unreadable while every chain, checkpoint and receipt still verifies.',
		link: ['Privacy and erasure', '/docs/concepts/privacy/'],
		file: { name: 'terminal', lang: 'shellsession', code: `$ tenbri erase ./audit/support --subject subj_7f3c91d2 --reason dsr:2026-1042 --yes
erased subject subj_7f3c91d2: 2 data key epochs deleted; erasure recorded at seq 7

$ tenbri verify ./audit/support --key sha256:9c1e…
verified 8 entries, stream tnb1:1702…b7d8, pinned to sha256:9c1e…` },
	},
	{
		badge: 'Anywhere',
		title: 'Your storage, any language',
		body: 'A stream is plain files in a directory, S3, R2 or MinIO, with the keys kept apart. Write from Python, TypeScript or Rust, or run tenbrid and use REST or gRPC from anything else.',
		link: ['tenbrid API', '/docs/reference/api/'],
		file: { name: 'terminal', lang: 'shellsession', code: `$ export TENBRI_STREAM=r2://audit/agents/support CLOUDFLARE_ACCOUNT_ID=…

$ curl -X POST https://tenbrid.internal:7070/v1/streams/support/intents \\
    -H "Authorization: Bearer $TOKEN" -H "Idempotency-Key: $(ulid)" \\
    -d '{"action":{"type":"issue_refund","target":"stripe:ch_81f2"}}'
{"entry":{"kind":"decision","phase":"intent","seq":3,…},"replayed":false}` },
	},
];


const svg = (path: string, hex: string) =>
	`<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path fill="#${hex}" d="${path}"/></svg>`;
const icon = (raw: string) => raw.replace(/<title>.*?<\/title>/, '').replace('<svg ', '<svg aria-hidden="true" ');
const frameworks = [
	{ name: 'Claude Agent SDK', href: '/docs/adapters/claude-agent-sdk/', icon: icon(claudeIcon) },
	{ name: 'OpenAI Agents SDK', href: '/docs/adapters/openai-agents/', icon: icon(openaiIcon) },
	{ name: 'LangGraph', href: '/docs/adapters/langgraph/', icon: icon(langgraphIcon) },
	{ name: 'LangChain', href: '/docs/adapters/langgraph/', icon: icon(langchainIcon) },
	{ name: 'Any Python function', href: '/docs/getting-started/quickstart/', icon: svg(siPython.path, siPython.hex) },
	{ name: 'Any TypeScript function', href: '/docs/getting-started/quickstart/', icon: svg(siTypescript.path, siTypescript.hex) },
];

// The recorded session: real output from the quickstart run, hashes shortened.
const session = [
	{ note: 'refund.py: @tenbri.decision on a refund function, called three times', cmd: 'TENBRI_STREAM=audit/support TENBRI_AGENT=agent:support python refund.py', out: 'pin this: sha256:18c44ddcc1b123d3…f94edc\nok: re_123\nrefused: over the 500 EUR ceiling\nerror: nothing to refund' },
	{ note: 'every call is an intent and an outcome', cmd: "tenbri tail audit/support -n 6 --no-follow | jq -c '{seq, phase, status, target: .action.target}'", out: '{"seq":3,"phase":"intent","status":null,"target":"stripe:ch_3PqX"}\n{"seq":4,"phase":"outcome","status":"ok","target":"stripe:ch_3PqX"}\n{"seq":5,"phase":"intent","status":null,"target":"stripe:ch_9ZzY"}\n{"seq":6,"phase":"outcome","status":"refused","target":"stripe:ch_9ZzY"}\n{"seq":7,"phase":"intent","status":null,"target":"stripe:ch_0"}\n{"seq":8,"phase":"outcome","status":"error","target":"stripe:ch_0"}' },
	{ note: 'anyone can verify it, offline, against the pinned key', cmd: 'tenbri verify audit/support --key sha256:18c44ddc…', out: 'verified 8 entries, stream tnb1:18c44ddcc1b123d3…7b00, pinned to sha256:18c44ddc…' },
	{ note: 'someone rewrites history: one refund now points elsewhere', cmd: "sed -i '' 's/ch_3PqX/ch_3PqZ/' audit/support/batches/000000000003.jsonl" },
	{ cmd: 'tenbri verify audit/support --key sha256:18c44ddc…', out: 'broken at seq 3: bad_signature: the signature does not verify\n2 entries verified before it, stream tnb1:18c44ddcc1b123d3…7b00' },
];

const regs = ['EU AI Act Art. 12, 14, 19, 26', 'GDPR Art. 22', 'DORA', 'NIS2', 'SOC 2', 'ISO/IEC 27001', 'ISO/IEC 42001', 'NIST AI RMF'];
---

<Site
	title={title}
	description={description}
	dark
	announce={{ text: 'Tenbri 0.1.0-beta.2: one line instruments Claude, OpenAI and LangGraph agents', href: '/docs/adapters/' }}
>
	<main>
		<section class="hero">
			<div class="wrap hero-inner">
				<h1 class="lockup">
					<Image src={mascot} alt="" width={160} height={160} densities={[1, 2, 3]} loading="eager" />
					<span>Tenbri</span>
					<span class="sr">: audit trail for AI agents</span>
				</h1>
				<p class="tagline">Proof of what your agents decided</p>
				<p class="lede">
					A tamper-evident audit trail for AI agents. Every tool call is signed and chained to the one
					before, so anyone can verify offline who acted, under which policy, from which inputs, and who
					approved. One line for Claude, OpenAI and LangGraph agents; plain files on storage you control.
				</p>

				<div class="installer">
					<div class="ibar">
						<span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
						<div class="itabs" role="tablist" aria-label="Install with">
							{installs.map((t, i) => (
								<button type="button" role="tab" class="itab" aria-selected={i === 0 ? 'true' : 'false'} data-cmd={t.cmd}>{t.id}</button>
							))}
						</div>
					</div>
					<div class="iline">
						<code><span class="pr">$</span> <span id="install-text">{installs[0].cmd}</span></code>
						<button type="button" class="icopy" id="icopy">copy</button>
					</div>
				</div>

				<div class="hbtns">
					<a class="hb primary" href="/docs/getting-started/quickstart/">
						<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 13c-1.5 1.3-2 3.7-2 6 2.3 0 4.7-.5 6-2m-1-4 3 3m7.5-12.5C16 2.5 11 4 8 8l-3 1-1 3 4 1 3 3 1 4 3-1 1-3c4-3 5.5-8 4.5-10.5z" /></svg>
						Get started
					</a>
					<a class="hb" href="/docs/examples/">
						<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m8 6-6 6 6 6m8-12 6 6-6 6" /></svg>
						Examples
					</a>
					<a class="hb" href="/docs/adapters/">
						<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 2v6m6-6v6M6 8h12v4a6 6 0 0 1-12 0zm6 10v4" /></svg>
						Adapters
					</a>
					<a class="hb" href="https://github.com/tenbri/tenbri">
						<svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
						GitHub
					</a>
				</div>

				<div class="shot">
					<CodeWindow files={quick} label="Instrument an agent" />
				</div>
				<div class="fw">
					{frameworks.map((f) => <a href={f.href}><span class="fi" set:html={f.icon} />{f.name}</a>)}
				</div>
			</div>
		</section>

		<section class="band alt" aria-labelledby="demo-title">
			<div class="wrap section-head center">
				<p class="eyebrow">See it run</p>
				<h2 id="demo-title">Record, verify, tamper, get caught</h2>
				<p class="sub">A refund function decorated with <code>@tenbri.decision</code>, called three times. Then someone edits one byte on disk. This is the real output, with hashes shortened.</p>
			</div>
			<div class="wrap narrow">
				<TerminalPlayer title="tenbri quickstart" steps={session} />
			</div>
		</section>

		<section class="band" aria-labelledby="blog-title">
			<div class="wrap story">
				<div class="story-copy">
					<div class="parties" aria-label="OpenAI agents attacked Hugging Face">
						<span class="party"><span class="fi" set:html={icon(openaiIcon)} />OpenAI</span>
						<svg class="arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
						<span class="party"><span class="fi" set:html={icon(hfIcon)} />Hugging Face</span>
					</div>
					<p class="eyebrow">From the blog · Incident analysis</p>
					<h2 id="blog-title">Five days to “it was us”</h2>
					<p class="sub">In July 2026, OpenAI agents broke out of an evaluation sandbox and attacked Hugging Face. Attribution took five days. What a signed record of every agent decision would have changed, and what it would not.</p>
					<a class="btn primary" href="/blog/five-days-to-it-was-us/">Read the analysis <span aria-hidden="true">→</span></a>
				</div>
				<ol class="story-stats">
					<li><strong>~17,600</strong><span>agent actions Hugging Face recovered from its own logs</span></li>
					<li><strong>5 days</strong><span>from the public disclosure to “it was us”</span></li>
					<li><strong>1 query</strong><span>with a Tenbri record: <code>tenbri query --target-domain</code>, on the roadmap</span></li>
				</ol>
			</div>
		</section>

		<section class="band">
			<div class="wrap section-head center">
				<p class="eyebrow">What you get</p>
				<h2>Built for the day something goes wrong</h2>
				<p class="sub">Disputes, incidents, policy changes and audits all ask the same question: what did the agent decide, and on whose authority?</p>
			</div>
			<div class="wrap rows">
				{features.map((f, i) => (
					<div class:list={['row', { flip: i % 2 === 1 }]}>
						<div class="row-code"><CodeWindow files={[f.file]} label={f.title} /></div>
						<div class="row-copy">
							<span class="badge">{f.badge}</span>
							<h3>{f.title}</h3>
							<p>{f.body}</p>
							<a class="more" href={f.link[1]}>{f.link[0]} <span aria-hidden="true">→</span></a>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="band alt">
			<div class="wrap regs">
				<div>
					<p class="eyebrow">Records these frameworks ask for</p>
					<h2>Evidence, not screenshots</h2>
					<p class="sub">Tenbri gives you the records. It does not make a system compliant on its own.</p>
				</div>
				<ul class="chips">{regs.map((r) => <li>{r}</li>)}</ul>
			</div>
		</section>

		<section class="cta">
			<div class="wrap cta-inner">
				<h2>Start recording decisions in five minutes</h2>
				<p>Open source, Apache-2.0, written in Rust. Plain files on storage you control, and no telemetry.</p>
				<div class="ctas">
					<a class="btn primary" href="/docs/getting-started/quickstart/">Read the quickstart</a>
					<a class="btn" href="/docs/examples/">Browse examples</a>
				</div>
			</div>
		</section>
	</main>

	<script>
		// Install tabs + copy
		const text = document.getElementById('install-text')!;
		const icopy = document.getElementById('icopy')!;
		const itabs = [...document.querySelectorAll<HTMLButtonElement>('.itab')];
		for (const tab of itabs) {
			tab.addEventListener('click', () => {
				for (const t of itabs) t.setAttribute('aria-selected', String(t === tab));
				text.textContent = tab.dataset.cmd ?? '';
			});
		}
		icopy.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(text.textContent ?? '');
				icopy.textContent = 'copied';
			} catch {
				getSelection()?.selectAllChildren(text);
			}
			setTimeout(() => (icopy.textContent = 'copy'), 1500);
		});

	</script>
</Site>

<style>
	h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; margin: 0; }
	h2 { font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.035em; font-weight: 800; }
	h3 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.1; letter-spacing: -0.025em; font-weight: 750; }
	p { margin: 0; }
	.eyebrow { font: 500 0.75rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--stamp); }
	.sub { color: var(--ink-2); font-size: 1.12rem; max-width: 42rem; }

	.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

	/* Hero, after omnigent.ai: lockup, coloured tagline, installer, button row, then the product */
	.hero { position: relative; }
	.hero-inner {
		display: flex; flex-direction: column; align-items: center; text-align: center;
		gap: 1.6rem;
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(3.5rem, 8vw, 5.5rem);
	}
	.lockup { display: flex; align-items: center; gap: clamp(0.4rem, 1.2vw, 0.8rem); margin: 0; }
	.lockup :global(img) { width: clamp(92px, 14vw, 160px); height: auto; margin-block: -0.6rem; }
	.lockup > span:not(.sr) { font: 800 clamp(3.2rem, 9vw, 6.2rem)/0.9 var(--font-display); letter-spacing: -0.05em; color: var(--ink); }
	.tagline {
		font: 750 clamp(1.7rem, 4.2vw, 2.7rem)/1.1 var(--font-display);
		letter-spacing: -0.03em;
		color: var(--stamp);
		text-wrap: balance;
	}
	.lede { color: var(--ink-2); font-size: clamp(1.05rem, 1.7vw, 1.25rem); line-height: 1.6; max-width: 46rem; }

	.installer {
		width: min(100%, 32rem);
		margin-top: 0.4rem;
		background: #0d1117;
		border: 1px solid #262c36;
		border-radius: 0.75rem;
		overflow: hidden;
		text-align: left;
	}
	.ibar { display: flex; align-items: center; gap: 1rem; padding: 0.5rem 0.75rem; border-bottom: 1px solid #262c36; background: #151b23; }
	.lights { display: flex; gap: 6px; flex: none; }
	.lights i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
	.lights i:nth-child(2) { background: #febc2e; }
	.lights i:nth-child(3) { background: #28c840; }
	.itabs { display: flex; gap: 0.15rem; overflow-x: auto; }
	.itabs button {
		flex: none;
		font: 400 0.76rem/1 var(--font-mono);
		padding: 0.4rem 0.6rem;
		border: 0; border-radius: 0.35rem;
		background: transparent; color: rgb(255 255 255 / 0.45);
		cursor: pointer;
	}
	.itabs button:hover { color: rgb(255 255 255 / 0.8); }
	.itabs [aria-selected='true'] { background: #262c36; color: #fff; }
	.iline { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 0.75rem 0.85rem 1rem; }
	.iline code { flex: 1; min-width: 0; font: 0.9rem/1.4 var(--font-mono); color: #e6edf3; white-space: nowrap; overflow-x: auto; }
	.iline .pr { color: #7ee2a8; }
	.icopy {
		flex: none;
		font: 0.72rem/1 var(--font-body);
		padding: 0.4rem 0.55rem;
		border: 1px solid #30363d; border-radius: 0.35rem;
		background: #21262d; color: #c9d1d9;
		cursor: pointer;
	}
	.icopy:hover { background: #30363d; }

	.hbtns { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
	.hb {
		display: inline-flex; align-items: center; gap: 0.55rem;
		padding: 0.75rem 1.15rem;
		border-radius: 0.6rem;
		border: 1px solid var(--rule);
		background: var(--paper-2);
		color: var(--ink);
		font: 550 0.95rem/1.2 var(--font-body);
