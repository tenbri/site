---
import { createHash } from 'node:crypto';
import { Image } from 'astro:assets';
import mascot from '../assets/mascot.webp';
import Site from '../layouts/Site.astro';

const title = 'Tenbri: audit trail for AI agents';
const description =
	'Open-source, tamper-evident record of what AI agents decided: hash-chained, signed and verifiable offline, on storage you control.';

const installs = [
	{ id: 'crates.io', cmd: 'cargo install tenbri-cli --version 0.1.0-alpha.2' },
	{ id: 'source', cmd: 'cargo install --git https://github.com/tenbri/tenbri tenbri-cli' },
];

// The demo chain. Simplified entries; hashes are real: SHA-256(0x00 || line), as in spec/format-v1.md.
const leaf = (line: string) =>
	'sha256:' + createHash('sha256').update(Buffer.concat([Buffer.from([0]), Buffer.from(line)])).digest('hex');
const base = [
	{ seq: 1, kind: 'approval', by: { kind: 'person', id: 'alice' }, action: { type: 'issue_refund', target: 'stripe:charge/ch_81f2' } },
	{ seq: 2, kind: 'decision', phase: 'intent', principal: { kind: 'agent', id: 'support-assistant' }, action: { type: 'issue_refund', target: 'stripe:charge/ch_81f2' }, inputs: [{ ref: 'policy:refund', version: '14' }], ext: { refund: { amount: 4200 } } },
	{ seq: 3, kind: 'decision', phase: 'outcome', principal: { kind: 'agent', id: 'support-assistant' }, action: { type: 'issue_refund' }, status: 'ok' },
];
let prev: string | null = null;
const chain = base.map((e) => {
	const entry = { ...e, prev };
	const hash = leaf(JSON.stringify(entry));
	prev = hash;
	return { entry, hash };
});
const short = (h: string | null) => (h ? h.slice(0, 15) + '…' + h.slice(-4) : 'none (genesis)');

const features = [
	{
		id: 'record',
		tab: 'Record',
		title: 'Intent before the action, outcome after.',
		body: 'An agent writes what it is about to do and why, then what happened. Approvals are their own signed entries, and an intent names the approval it relies on by hash. An intent with no outcome after an hour gets a reconcile entry, so silence is visible too.',
		points: ['Kinds: decision, approval, key, reconcile, note', 'Inputs pinned by ref, version and content digest', 'Links to entries in other streams: cause, handoff, approval', 'OpenTelemetry trace and span ids on every entry'],
		code: `$ echo '{"kind":"decision","phase":"intent","source":"sdk",
  "principal":{"kind":"agent","id":"support-assistant"},
  "action":{"type":"reply_ticket","target":"zendesk:ticket/4821"},
  "inputs":[{"ref":"policy:refund","version":"14", …}]}' \\
  | tenbri append ./support

$ echo '{"kind":"decision","phase":"outcome","source":"sdk",
  "intent":"01M4XBH0Y60000000000000003","status":"ok", …}' \\
  | tenbri append ./support`,
		status: 'stable',
	},
	{
		id: 'verify',
		tab: 'Verify',
		title: 'Anyone can check it, offline.',
		body: 'Verification needs the stream and one fingerprint, nothing from your systems. It checks canonical bytes, the hash chain, every signature and every key. A checkpoint you saw before also catches truncation and forks.',
		points: ['Ed25519 signatures over canonical JSON (RFC 8032, strict)', 'RFC 6962 leaf hashes; Merkle checkpoints as C2SP signed notes', 'Exit codes: 0 ok · 1 broken · 3 not pinned'],
		code: `$ tenbri verify ./support --key sha256:9c1e…
verified 1204 entries, stream tnb1:1702…b7d8, pinned to sha256:9c1e…

# someone edits one byte of seq 3
$ tenbri verify ./support --key sha256:9c1e…
broken at seq 3: bad_signature
2 entries verified before it, stream tnb1:1702…b7d8

# someone deletes the tail
$ tenbri verify ./support --key sha256:9c1e… --checkpoint cp.txt
broken at seq 9: truncated`,
		status: 'stable',
	},
	{
		id: 'query',
		tab: 'Query',
		title: 'Find every decision made under the old rule.',
		body: 'When a policy changes, list what was decided under the previous version and review it. Each result comes with its verification status, one JSON per line, ready for jq.',
		points: ['Filter by input ref@version, repeatable', 'Filter by action type', 'Follow live with tail, like tail -f'],
		code: `# everything decided under refund policy v14
$ tenbri query ./support --input policy:refund@14

# every ticket reply, with the contract it relied on
$ tenbri query ./support --action reply_ticket \\
    --input contract:acme-sante@3

# watch decisions as agents write them
$ tenbri tail ./support -n 20`,
		status: 'stable',
	},
	{
		id: 'schemas',
		tab: 'Schemas',
		title: 'Say what each action must record.',
		body: 'Declare actions in tenbri.toml: which inputs they need, whether a rule and an approval are required, and typed fields. Check whole streams against it in CI.',
		points: ['Unknown actions: reject or warn', 'Required inputs, rule, approval and durability', 'Typed extension fields'],
		code: `# tenbri.toml
unknown_actions = "reject"

[actions.issue_refund]
inputs = ["policy:refund"]
rule = true
approval = true
durability = "replicated"
target = "stripe:charge/*"

[actions.issue_refund.fields."ext.refund.amount"]
required = true
type = "integer"

$ tenbri schema check --schema tenbri.toml ./refunds
./refunds seq 3: rule: required
./refunds: 3 entries, 1 break their schema`,
		status: 'stable',
	},
	{
		id: 'keys',
		tab: 'Keys',
		title: 'A key per stream, a session key per run.',
		body: 'Init makes a stream key and prints its fingerprint: pin it wherever you verify. Writers sign with short-lived session keys certified by the stream key. Rotation and revocation are entries in the chain, and revocation can reach back in time.',
		points: ['Session keys last 24 hours by default', 'Rotate and revoke from Rust (Writer::rotate, revoke)', 'Secret keys in files or the macOS and Windows keychain'],
		code: `$ tenbri init ./support --keychain
created stream tnb1:1702…b7d8 at ./support
stream key fingerprint (pin it): sha256:9c1e…
keys: ~/.config/tenbri/keys
verify with: tenbri verify ./support --key sha256:9c1e…`,
		status: 'stable',
	},
	{
		id: 'storage',
		tab: 'Storage',
		title: 'Plain files, in a bucket you own.',
		body: 'A stream is a directory or an object-store prefix. Nothing is hosted, nothing phones home. Keep the keys apart from the stream, and give auditors read access to the bucket, not to your systems.',
		points: ['Local disk, Cloudflare R2 and MinIO', 'AWS S3: tested on MinIO, real S3 before beta.1', 'Google Cloud Storage and Azure Blob next'],
		code: `$ tenbri init ./support                        # local disk
$ tenbri init s3://audit/agents/support        # AWS S3, MinIO
$ tenbri init r2://audit/agents/support        # Cloudflare R2

# MinIO
export AWS_ENDPOINT_URL=http://localhost:9000 AWS_ALLOW_HTTP=true
# R2
export CLOUDFLARE_ACCOUNT_ID=… AWS_ACCESS_KEY_ID=… AWS_SECRET_ACCESS_KEY=…`,
		status: 'mixed',
	},
	{
		id: 'api',
		tab: 'API',
		title: 'A daemon for every language: tenbrid.',
		body: 'Run tenbrid next to your agents and write over REST or gRPC. Writes are idempotent, reads stream, and verification is one call. An OpenAPI file and the proto contract are in the repo.',
		points: ['Bearer-token auth', 'Idempotency-Key on every write', 'Tail resumes from Last-Event-ID'],
		code: `POST /v1/streams/{stream}/intents
POST /v1/streams/{stream}/outcomes
POST /v1/streams/{stream}/approvals
POST /v1/streams/{stream}/entries
GET  /v1/streams/{stream}/entries
GET  /v1/streams/{stream}/entries/{id}
GET  /v1/streams/{stream}/tail
GET  /v1/streams/{stream}/verify

service tenbri.v1.TenbriService {
  AppendIntent · AppendOutcome · AppendApproval · AppendBatch
  GetEntry · QueryEntries · TailEntries · VerifyStream
}`,
		status: 'stable',
	},
	{
		id: 'rust',
		tab: 'Rust',
		title: 'Embed the writer.',
		body: 'Use tenbri-writer, tenbri-keys and tenbri-store from Rust today. The tenbri facade crate and the Python, Node and WASM bindings are reserved names; their code lands before v0.1.0.',
		points: ['Async writer over any store', 'verify() returns a report you can act on', 'Python, Node and WASM verifier next'],
		code: `let sk = Key::new_stream()?;
let session = Key::new_session(now_ms(), SESSION_LIFETIME_MS)?;
let mut w = Writer::create(store.clone(), &sk, session).await?;

let i = w.intent(decision("reply_ticket")).await?;
// … the agent acts …
w.outcome(&i, Status::Ok).await?;

let report = verify(&store, Some(&sk.fingerprint())).await?;`,
		status: 'stable',
	},
];

const next = [
	'Receipts an auditor verifies alone',
	'Blob encryption and per-subject erasure',
	'RFC 3161 timestamps',
	'SQLite and Parquet index',
	'Python, Node and WASM verifier',
	'Claude Agent SDK, OpenAI Agents SDK, LangGraph adapters',
];

const regs = ['EU AI Act Art. 12, 14, 19, 26', 'GDPR Art. 22', 'DORA', 'NIS2', 'SOC 2', 'ISO/IEC 27001', 'ISO/IEC 42001', 'NIST AI RMF'];
---

<Site title={title} description={description}>
		<main>
			<section class="hero wrap">
				<div class="lockup">
					<Image src={mascot} alt="Tenbri's mascot, a pangolin detective" width={104} height={104} densities={[1, 2, 3]} loading="eager" />
					<span>Tenbri</span>
				</div>
				<h1>Proof of what your agents decided.</h1>
				<p class="lede">
					A tamper-evident audit trail for AI agents. Each decision is signed and chained to the one
					before, so anyone can verify offline who acted, under which policy version, from which
					inputs, and who approved.
				</p>

				<div class="install">
					<div class="tabs" role="tablist" aria-label="Install from">
						{installs.map((t, i) => (
							<button type="button" role="tab" class="itab" aria-selected={i === 0 ? 'true' : 'false'} data-cmd={t.cmd}>{t.id}</button>
						))}
						<button type="button" class="copy" id="copy">copy</button>
					</div>
					<code id="install-cmd">{installs[0].cmd}</code>
				</div>

				<div class="ctas">
					<a class="btn primary" href="/docs/introduction/">Get started</a>
					<a class="btn" href="https://github.com/tenbri/tenbri">Star on GitHub</a>
					<a class="btn" href="https://github.com/tenbri/tenbri/blob/main/spec/format-v1.md">Read the spec</a>
				</div>
			</section>

			<!-- Interactive: a three-entry chain the visitor can tamper with -->
			<section class="wrap demo" aria-labelledby="demo-title">
				<div class="demo-head">
					<div>
						<p class="eyebrow">Try it</p>
						<h2 id="demo-title">Change one number. Watch the chain break.</h2>
					</div>
					<p class="demo-note">A refund an agent issued after Alice approved it. Edit the amount and see what verification says.</p>
				</div>

				<div class="chain" id="chain" data-state="ok">
					<script type="application/json" id="chain-data" set:html={JSON.stringify(chain.map((c) => c.entry))} />

					<article class="entry">
						<header><span>seq 1</span><span class="kind">approval</span></header>
						<dl>
							<dt>by</dt><dd>alice · person</dd>
							<dt>action</dt><dd>issue_refund</dd>
							<dt>target</dt><dd>stripe:charge/ch_81f2</dd>
						</dl>
						<footer>
							<div><span>prev</span><code>{short(null)}</code></div>
							<div><span>hash</span><code>{short(chain[0].hash)}</code></div>
							<div class="sig ok"><span>sig</span><code>valid</code></div>
						</footer>
					</article>

					<div class="link" aria-hidden="true"><i></i></div>

					<article class="entry target">
						<header><span>seq 2</span><span class="kind">decision · intent</span></header>
						<dl>
							<dt>agent</dt><dd>support-assistant</dd>
							<dt>action</dt><dd>issue_refund</dd>
							<dt>inputs</dt><dd>policy:refund @14</dd>
							<dt><label for="amount">amount</label></dt>
							<dd class="amount"><input id="amount" type="number" inputmode="numeric" value="4200" min="0" step="100" aria-describedby="demo-hint" /><span>cents</span></dd>
						</dl>
						<footer>
							<div><span>prev</span><code>{short(chain[0].hash)}</code></div>
							<div><span>hash</span><code id="hash-2">{short(chain[1].hash)}</code></div>
							<div class="sig ok" id="sig-2"><span>sig</span><code>valid</code></div>
						</footer>
					</article>

					<div class="link" id="link-3" aria-hidden="true"><i></i></div>

					<article class="entry">
						<header><span>seq 3</span><span class="kind">decision · outcome</span></header>
						<dl>
							<dt>agent</dt><dd>support-assistant</dd>
							<dt>intent</dt><dd>seq 2</dd>
							<dt>status</dt><dd>ok</dd>
						</dl>
						<footer>
							<div class="prev-3"><span>prev</span><code>{short(chain[1].hash)}</code></div>
							<div><span>hash</span><code>{short(chain[2].hash)}</code></div>
							<div class="sig ok"><span>sig</span><code>valid</code></div>
						</footer>
					</article>
				</div>

				<div class="demo-foot">
					<pre class="term" aria-live="polite" id="verify-out"><span class="p">$</span> tenbri verify ./refunds --key sha256:9c1e…
<span class="ok">verified 3 entries</span>, stream tnb1:1702…b7d8, pinned to sha256:9c1e…</pre>
					<div class="demo-actions">
						<button type="button" class="btn" id="tamper">Make it 42 000</button>
						<button type="button" class="btn" id="restore" disabled>Restore</button>
						<p id="demo-hint">Hashes are computed in your browser with SHA-256, as the spec does. Signatures are simulated.</p>
					</div>
				</div>
			</section>

			<!-- Feature explorer -->
			<section class="wrap explorer" aria-labelledby="features-title">
				<div class="section-head">
					<p class="eyebrow">What you get</p>
					<h2 id="features-title">Everything an audit needs, in one small tool.</h2>
				</div>

				<div class="ex">
					<div class="ex-tabs" role="tablist" aria-label="Features" aria-orientation="vertical">
						{features.map((f, i) => (
							<button type="button" role="tab" id={`ft-${f.id}`} aria-controls={`fp-${f.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
								{f.tab}
							</button>
						))}
					</div>
					{features.map((f, i) => (
						<div class="ex-panel" role="tabpanel" id={`fp-${f.id}`} aria-labelledby={`ft-${f.id}`} hidden={i !== 0}>
							<div class="ex-copy">
								<span class={`status ${f.status}`}>{f.status === 'stable' ? 'Available in alpha' : 'Partly available'}</span>
								<h3>{f.title}</h3>
								<p>{f.body}</p>
								<ul>{f.points.map((p) => <li>{p}</li>)}</ul>
							</div>
							<pre class="term code">{f.code}</pre>
						</div>
					))}
				</div>
			</section>

			<section class="wrap split">
				<div>
					<p class="eyebrow">Next on the way to v0.1.0</p>
					<ul class="next">{next.map((n) => <li>{n}</li>)}</ul>
					<a class="more" href="https://github.com/tenbri/tenbri#status">Full roadmap</a>
				</div>
				<div>
					<p class="eyebrow">Records these frameworks ask for</p>
					<ul class="chips">{regs.map((r) => <li>{r}</li>)}</ul>
					<p class="fine">Tenbri gives you the records. It does not make a system compliant on its own.</p>
				</div>
			</section>

			<section class="closing">
				<div class="wrap closing-row">
					<div>
						<h2>Early, open, and built in public.</h2>
						<p>0.1.0-alpha.2 is out. The format is provisional until its external review ends. Apache-2.0, written in Rust, no telemetry.</p>
					</div>
					<div class="ctas">
						<a class="btn primary" href="https://github.com/tenbri/tenbri">Star on GitHub</a>
						<a class="btn" href="/blog/">Read the blog</a>
					</div>
				</div>
			</section>
		</main>
		<script>
			// Install tabs + copy
			const cmd = document.getElementById('install-cmd')!;
			const copy = document.getElementById('copy')!;
			const itabs = [...document.querySelectorAll<HTMLButtonElement>('.itab')];
			for (const tab of itabs) {
				tab.addEventListener('click', () => {
					for (const t of itabs) t.setAttribute('aria-selected', String(t === tab));
					cmd.textContent = tab.dataset.cmd ?? '';
				});
			}
			copy.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(cmd.textContent ?? '');
					copy.textContent = 'copied';
				} catch {
					getSelection()?.selectAllChildren(cmd);
				}
				setTimeout(() => (copy.textContent = 'copy'), 1500);
			});

			// Feature explorer tabs (arrow keys move between tabs)
			const ftabs = [...document.querySelectorAll<HTMLButtonElement>('.ex-tabs [role="tab"]')];
			const select = (tab: HTMLButtonElement) => {
				for (const t of ftabs) {
					const on = t === tab;
					t.setAttribute('aria-selected', String(on));
					t.tabIndex = on ? 0 : -1;
					document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
				}
			};
			ftabs.forEach((tab, i) => {
				tab.addEventListener('click', () => select(tab));
				tab.addEventListener('keydown', (e) => {
					const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
					if (!d) return;
					e.preventDefault();
					const next = ftabs[(i + d + ftabs.length) % ftabs.length];
					select(next);
					next.focus();
				});
			});

			// Tamper demo
			const entries = JSON.parse(document.getElementById('chain-data')!.textContent!);
			const original = entries[1].ext.refund.amount as number;
			const chainEl = document.getElementById('chain')!;
			const amount = document.getElementById('amount') as HTMLInputElement;
			const out = document.getElementById('verify-out')!;
			const restore = document.getElementById('restore') as HTMLButtonElement;
			const short = (h: string) => h.slice(0, 15) + '…' + h.slice(-4);
			const leaf = async (line: string) => {
				const bytes = new Uint8Array([0, ...new TextEncoder().encode(line)]);
				const d = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
				return 'sha256:' + [...d].map((b) => b.toString(16).padStart(2, '0')).join('');
			};
			const head = '<span class="p">$</span> tenbri verify ./refunds --key sha256:9c1e…\n';
			const render = async () => {
				const value = Number(amount.value);
				const e = structuredClone(entries[1]);
				e.ext.refund.amount = value;
				document.getElementById('hash-2')!.textContent = short(await leaf(JSON.stringify(e)));
				const broken = value !== original;
				chainEl.dataset.state = broken ? 'broken' : 'ok';
				const sig = document.getElementById('sig-2')!;
				sig.className = 'sig ' + (broken ? 'bad' : 'ok');
				sig.querySelector('code')!.textContent = broken ? 'invalid' : 'valid';
				restore.disabled = !broken;
				out.innerHTML = broken
					? head + '<span class="bad">broken at seq 2: bad_signature</span>\n1 entries verified before it, stream tnb1:1702…b7d8'
					: head + '<span class="ok">verified 3 entries</span>, stream tnb1:1702…b7d8, pinned to sha256:9c1e…';
			};
			amount.addEventListener('input', render);
			document.getElementById('tamper')!.addEventListener('click', () => {
				amount.value = '42000';
				render();
			});
			restore.addEventListener('click', () => {
				amount.value = String(original);
				render();
			});
		</script>
</Site>

<style>
	h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; margin: 0; }
	h2 { font-size: clamp(1.75rem, 3.2vw, 2.5rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 750; }
	h3 { font-size: 1.35rem; line-height: 1.2; font-weight: 700; letter-spacing: -0.015em; }
	p, ul { margin: 0; }
	code, pre { font-family: var(--font-mono); }
	.eyebrow {
		font: 500 0.75rem/1 var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--stamp);
	}

	/* Hero */
	.hero {
		display: flex; flex-direction: column; align-items: center; text-align: center;
		gap: 1.4rem;
		padding-block: clamp(3rem, 7vw, 5rem) clamp(2.5rem, 5vw, 3.5rem);
	}
	.lockup { display: flex; align-items: center; gap: clamp(0.5rem, 1.5vw, 0.9rem); }
	.lockup :global(img) { width: clamp(68px, 9vw, 104px); height: auto; }
	.lockup span { font: 800 clamp(3.2rem, 8.5vw, 6rem)/0.9 var(--font-display); letter-spacing: -0.05em; }
	.hero h1 { font-size: clamp(1.55rem, 3.4vw, 2.5rem); line-height: 1.1; letter-spacing: -0.03em; font-weight: 750; color: var(--stamp); }
	.lede { color: var(--ink-2); font-size: 1.1rem; max-width: 37rem; }

	.install {
		width: min(100%, 36rem);
		background: var(--term-bg); color: var(--term-fg);
		border-radius: 0.75rem;
		text-align: left;
		overflow: hidden;
		margin-top: 0.4rem;
	}
	.tabs { display: flex; align-items: center; gap: 0.25rem; padding: 0.5rem 0.5rem 0; }
	.tabs button {
		font: 500 0.75rem/1 var(--font-mono);
		padding: 0.45rem 0.65rem;
		border: 0; border-radius: 0.4rem;
		background: transparent; color: var(--term-dim);
		cursor: pointer;
	}
	.tabs [aria-selected='true'] { background: var(--term-chip); color: var(--term-fg); }
	.tabs .copy { margin-left: auto; border: 1px solid var(--term-chip); }
	.install code { display: block; padding: 0.9rem 1rem 1rem; font-size: 0.86rem; white-space: nowrap; overflow-x: auto; }
	.install code::before { content: '$ '; color: var(--term-prompt); }

	.ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
	.btn {
		display: inline-flex; align-items: center;
		padding: 0.65rem 1.1rem;
		border-radius: 0.6rem;
		border: 1px solid var(--rule);
		background: var(--paper);
		color: var(--ink);
		font: 600 0.94rem/1.2 var(--font-body);
		text-decoration: none;
		cursor: pointer;
		transition: border-color 0.15s ease;
	}
	.btn:hover:not(:disabled) { border-color: var(--ink-2); }
	.btn:disabled { opacity: 0.45; cursor: default; }
	.btn.primary { background: var(--stamp); border-color: var(--stamp); color: #fff; }

	.section-head { display: grid; gap: 0.8rem; max-width: 42rem; }

	/* Demo */
	.demo { display: grid; gap: 1.75rem; padding-block: clamp(2.5rem, 6vw, 4rem); }
	.demo-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 2rem; }
	.demo-head > div { display: grid; gap: 0.8rem; max-width: 34rem; }
	.demo-note { color: var(--ink-2); max-width: 26rem; font-size: 0.98rem; }

	.chain {
		display: grid;
