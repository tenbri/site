---
// Served by the worker for unknown paths outside /docs/ (the docs app exports its own 404).
import Site from '../layouts/Site.astro';
---

<Site title="Page not found · Tenbri" description="This page does not exist.">
	<main class="wrap nf">
		<h1>Page not found</h1>
		<p>This page does not exist, or it moved.</p>
		<p><a href="/">Home</a> · <a href="/docs/introduction/">Docs</a> · <a href="/blog/">Blog</a></p>
	</main>
</Site>

<style>
	.nf { padding: 6rem 0; text-align: center; }
	.nf h1 { font: 750 2.4rem/1.1 var(--font-display); margin: 0 0 0.75rem; }
	.nf p { color: var(--ink-2); }
	.nf a { color: var(--stamp); }
</style>
